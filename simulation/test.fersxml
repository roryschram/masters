<!--Simulation input file. Monostatic, flying target-->
<?xml version="1.0" ?>
<!DOCTYPE simulation SYSTEM "../../fers-xml.dtd">
<simulation name="sim1">

<parameters>
 <starttime>0</starttime>
 <endtime>0.1</endtime>
 <rate>12.5e6</rate>
 <export binary="true" csvbinary="false" xml="false"/>
</parameters>

<pulse name="pulse1" type="file" filename="chirp.h5">
 <power>10e3</power>
 <carrier>2.79e9</carrier>
</pulse>

<timing name="clock">
 <frequency>100e6</frequency>
</timing>

<antenna name="isotropic" pattern="isotropic">
</antenna>

<platform name="Test radar">
 <motionpath>
  <positionwaypoint>
   <x>0</x>
   <y>0</y>
   <altitude>0</altitude>
   <time>0</time>
  </positionwaypoint>
 </motionpath>
 <fixedrotation>
  <startazimuth>0.0</startazimuth>
  <azimuthrate>0</azimuthrate>
  <startelevation>0</startelevation>
  <elevationrate>0</elevationrate>
 </fixedrotation>
 <monostatic name="Monostatic" type="pulsed" antenna="isotropic" pulse="pulse1" timing="clock">
  <window_skip>0</window_skip>
  <window_length>0.1</window_length>
  <prf>1</prf>
  <noise_temp>0.0000001</noise_temp>
 </monostatic>
</platform>

<platform name="target">
 <motionpath interpolation="linear">
  <positionwaypoint>
   <x>50</x>
   <y>0</y>
   <altitude>0</altitude>
   <time>0</time>
  </positionwaypoint>
 </motionpath>
 <fixedrotation>
  <startazimuth>0.0</startazimuth>
  <startelevation>0.0</startelevation>
  <azimuthrate>0</azimuthrate>
  <elevationrate>0</elevationrate>
 </fixedrotation>
 <target name="wings">
  <rcs type="isotropic">
   <value>5000</value>
  </rcs>
 </target>
</platform>
</simulation>