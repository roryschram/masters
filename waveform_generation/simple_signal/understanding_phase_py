import numpy as np
import matplotlib.pyplot as plt

t = np.linspace(0, 1, 1000)
f = 5  # Hz
phi_0 = np.pi/4

x = np.exp(1j * (2 * np.pi * f * t + phi_0))

plt.plot(t, np.angle(x))
plt.title('Phase of Complex Exponential')
plt.xlabel('Time (s)')
plt.ylabel('Phase (radians)')
plt.grid(True)
plt.show()
